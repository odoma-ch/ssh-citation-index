# Citation Index API and Worker Configuration
# Copy this file to .env and update with your values.
# Comments sit on their own lines so values parse cleanly.

# ========================
# API
# ========================
# Clients must send this as the X-API-Key header (/health is exempt).
# Leave empty to disable auth (local dev only). Generate: openssl rand -hex 32
API_KEY=
API_HOST=0.0.0.0
API_PORT=8000
# Set to True for development hot reload
API_RELOAD=False
# Number of uvicorn workers
API_WORKERS=1

# ========================
# Redis
# ========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Optional
# REDIS_PASSWORD=your-redis-password

# ========================
# Storage and job metadata
# ========================
# Local filesystem path (use K8s PV mount in production)
STORAGE_ROOT=./storage
STORAGE_CLEANUP_AGE_HOURS=24
# How long to keep job metadata in Redis (seconds)
JOB_METADATA_TTL=7200

# ========================
# Worker
# ========================
# How long to keep results in Redis (seconds)
WORKER_RESULT_TTL=3600
# Default job timeout (seconds)
WORKER_DEFAULT_TIMEOUT=600

# Queue timeouts (RQ job timeout, hard-kills the worker process).
# LLM queues must exceed: llm_timeout x (llm_max_retries + 1) + buffer
#   reference extraction: 300 x 4 + 120 = 1320 -> 1500
#   reference parsing:    600 x 4 + 120 = 2520 -> 2700
TIMEOUT_TEXT_EXTRACTION=1500
TIMEOUT_REFERENCE_EXTRACTION=1500
TIMEOUT_REFERENCE_PARSING=2700
# Must exceed CEC_TIMEOUT
TIMEOUT_CEC_CLASSIFICATION=1000
# OpenCitations SPARQL fallback averages ~6s per reference
TIMEOUT_CITATION_LINKING=3600

# ========================
# LLM (vLLM)
# ========================
LLM_ENDPOINT=http://localhost:8000/v1
LLM_MODEL_MEDIUM_INTELLIGENCE=Qwen3.6-27B
LLM_MODEL_HIGH_INTELLIGENCE=your-model-name
# Optional for local vLLM
LLM_API_KEY=
LLM_TIMEOUT=300.0
LLM_MAX_RETRIES=3
# Keep false: Qwen reasoning channel breaks structured JSON output
LLM_ENABLE_THINKING=false
# Task-specific first token timeouts (seconds)
LLM_FIRST_TOKEN_TIMEOUT_REFERENCE_PARSING=30.0
LLM_FIRST_TOKEN_TIMEOUT_REFERENCE_EXTRACTION=90.0
LLM_FIRST_TOKEN_TIMEOUT_END_TO_END=90.0
LLM_TIMEOUT_REFERENCE_PARSING=600.0
# Unused: vLLM handles concurrency, worker replica count is the limit.
LLM_MAX_CONCURRENT=4

# ========================
# Embedding service
# ========================
EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct
EMBEDDING_ENDPOINT=http://localhost:7997/v1/embeddings
# Optional for local embedding service
EMBEDDING_API_KEY=

# ========================
# PDF extraction
# ========================
GROBID_ENDPOINT=http://localhost:8070
GROBID_TIMEOUT=180.0

MINERU_ENDPOINT=http://localhost:8000
MINERU_TIMEOUT=1200.0
MINERU_BACKEND=vlm-auto-engine

# ========================
# CEC classifier
# ========================
# Base URL; the client appends /cic/api/classify.
# Keep the timeout below the 900s server/Route limit.
CEC_ENDPOINT=http://localhost:5000
CEC_TIMEOUT=800.0

# ========================
# Citation linking
# ========================
# OpenAlex API key (sent as a Bearer token)
OPENALEX_API=
# OpenCitations access token (optional): sent as the raw `authorization` header,
# no Bearer. Identifies the caller; the limit is 180 requests/minute per IP.
# Get one at https://opencitations.net/accesstoken
OPENCITATIONS_API=
# Matilda credentials
MATILDA_USERNAME=
MATILDA_PASSWORD=
