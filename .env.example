# Citation Index API and Worker Configuration
# Copy this file to .env and update with your values

# ========================
# Redis Configuration
# ========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your-redis-password  # Optional

# ========================
# Storage Configuration
# ========================
# Local filesystem path (use K8s PV mount in production)
STORAGE_ROOT=./storage
STORAGE_CLEANUP_AGE_HOURS=24

# ========================
# LLM Configuration (vLLM)
# ========================
LLM_ENDPOINT=http://localhost:8000/v1
LLM_MODEL_MEDIUM_INTELLIGENCE=Qwen3.6-27B-FP8
LLM_MODEL_HIGH_INTELLIGENCE=your-model-name
# LLM_MODEL=your-model-name  # Deprecated: use LLM_MODEL_MEDIUM_INTELLIGENCE
LLM_API_KEY=your-api-key  # Optional for local vLLM
LLM_TIMEOUT=300.0
LLM_MAX_RETRIES=3
LLM_ENABLE_THINKING=false  # Disable Qwen reasoning channel for structured JSON output

# Task-specific first token timeouts (seconds)
LLM_FIRST_TOKEN_TIMEOUT_REFERENCE_PARSING=30.0
LLM_FIRST_TOKEN_TIMEOUT_REFERENCE_EXTRACTION=90.0
LLM_FIRST_TOKEN_TIMEOUT_END_TO_END=90.0
LLM_TIMEOUT_REFERENCE_PARSING=600.0

# LLM_MAX_CONCURRENT is retained in config.py but the application-level
# semaphore has been removed.  vLLM handles concurrency natively; worker
# replica count (docker-compose replicas) is the natural limit.
LLM_MAX_CONCURRENT=4

# ========================
# GROBID Configuration
# ========================
GROBID_ENDPOINT=http://localhost:8070
GROBID_TIMEOUT=180.0

# ========================
# MinerU Configuration
# ========================
MINERU_ENDPOINT=http://localhost:8000
MINERU_TIMEOUT=1200.0
MINERU_BACKEND=vlm-auto-engine

# ========================
# Worker Configuration
# ========================
WORKER_RESULT_TTL=3600  # How long to keep results in Redis (seconds)
WORKER_DEFAULT_TIMEOUT=600  # Default job timeout (seconds)

# Queue-specific timeouts (RQ job timeout – hard-kills worker process)
#
# IMPORTANT – These must be larger than:
#   llm_timeout × (llm_max_retries + 1) + buffer
#
# With LLM_TIMEOUT=300, LLM_MAX_RETRIES=3, buffer=120:
#   reference extraction = 300 × 4 + 120 = 1320  → set 1500
# With LLM_TIMEOUT_REFERENCE_PARSING=600, LLM_MAX_RETRIES=3, buffer=120:
#   reference parsing    = 600 × 4 + 120 = 2520  → set 2700
TIMEOUT_TEXT_EXTRACTION=1500
TIMEOUT_REFERENCE_EXTRACTION=1500
TIMEOUT_REFERENCE_PARSING=2700
TIMEOUT_CITATION_LINKING=600

# ========================
# API Configuration
# ========================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=False  # Set to True for development hot reload
API_WORKERS=1  # Number of uvicorn workers

# ========================
# Job Metadata Configuration
# ========================
JOB_METADATA_TTL=7200  # How long to keep job metadata in Redis (seconds)

# ========================
# Embedding Service Configuration
# ========================
EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct
EMBEDDING_ENDPOINT=http://localhost:7997/v1/embeddings
EMBEDDING_API_KEY=your-api-key  # Optional for local embedding service
