	url = {https://www.jstor.org/stable/10.5615/jcunestud.67.2015.0003},
	doi = {10.5615/jcunestud.67.2015.0003},
	abstract = {Abstract This contribution is a first attempt at analyzing scattered pieces of evidence found in the Royal Palace G of mature Early Syrian Ebla (ca. 2300 BCE), which, in light of the discovery of a nearly complete standard of the queen (maliktum) recovered from the same building, may be interpreted as standards, namely, as paraphernalia of the highest officials of the Ebla court. The main focus is a group of fragments that may belong to the standard of the king (en). According my reconstruction, Ebla officials carried standards with one figure during state ceremonies, possibly a mark of their role at court, while the king and queen carried standards with three figures, possibly hinting at the concept of kingship at Ebla.},
	urldate = {2020-03-31},
